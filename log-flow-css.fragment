/* ── LOG FLOW WIZARD (activation-first, build 186+) ── */
.log-flow-screen{
  padding:16px;
  min-height:calc(100vh - 52px);
  display:flex;
  flex-direction:column;
  box-sizing:border-box;
  padding-bottom:120px;
}
.log-flow-screen .page-header{margin:-16px -16px 0;padding:0 16px;}
.log-flow-body{flex:1;max-width:480px;width:100%;margin:0 auto;}
.log-flow-footer{
  position:fixed;
  left:50%;
  transform:translateX(-50%);
  bottom:0;
  width:100%;
  max-width:640px;
  padding:0 16px calc(12px + env(safe-area-inset-bottom, 0px));
  box-sizing:border-box;
  z-index:20;
  background:linear-gradient(to top, var(--bg) 70%, transparent);
}
.log-flow-cta{
  margin:0 0 10px;
  width:100%;
  opacity:.25;
  pointer-events:none;
}
.log-flow-cta.ready{
  opacity:1;
  pointer-events:all;
}

/* Mercury-like thin progress bar — fixed above safe area */
.log-flow-progress{
  padding:8px 0 4px;
}
.log-flow-progress-track{
  height:3px;
  background:rgba(255,255,255,.08);
  border-radius:99px;
  overflow:hidden;
}
.log-flow-progress-fill{
  height:100%;
  background:var(--accent);
  border-radius:99px;
  transition:width .35s ease;
}
.log-flow-progress-label{
  font-size:10px;
  font-weight:600;
  letter-spacing:.06em;
  text-transform:uppercase;
  color:var(--muted2);
  text-align:center;
  margin-top:6px;
}

/* Reveal / compare screen — calm, spacious */
.log-flow-reveal{
  text-align:center;
  padding:8px 0 24px;
}
.log-flow-reveal .screen-title{margin-bottom:20px;}
.log-flow-reveal-intro{
  font-size:14px;
  color:var(--muted);
  line-height:1.55;
  margin-bottom:24px;
  max-width:320px;
  margin-left:auto;
  margin-right:auto;
}
#log-reveal-gauge{
  width:100%;
  max-width:280px;
  margin:0 auto 28px;
}
.log-flow-reveal-options{
  display:flex;
  flex-direction:column;
  gap:10px;
  max-width:360px;
  margin:0 auto;
}
.log-flow-reveal-options button{
  width:100%;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--r-lg);
  color:var(--text);
  font-family:'Space Grotesk',sans-serif;
  font-size:15px;
  font-weight:600;
  padding:16px 18px;
  cursor:pointer;
  -webkit-tap-highlight-color:transparent;
  transition:background .15s, border-color .15s;
}
.log-flow-reveal-options button:active{
  transform:scale(.98);
}
.log-flow-reveal-options button.primary-choice{
  background:var(--accent-dim);
  border-color:rgba(232,118,58,.35);
}
#log-reveal-dial-wrap{
  margin-top:16px;
  padding-top:16px;
  border-top:1px solid var(--border);
}
#log-reveal-adjust-gauge{
  width:100%;
  max-width:260px;
  margin:12px auto 0;
}

/* Prompt + done screens — no progress bar, centered CTAs */
.log-flow-prompt-body,
.log-flow-done-body{
  flex:1;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  max-width:360px;
  margin:0 auto;
  padding:24px 0;
}
.log-flow-prompt-body .screen-title,
.log-flow-done-body .screen-title{margin-bottom:12px;}
.log-flow-prompt-sub{
  font-size:14px;
  color:var(--muted);
  margin-bottom:32px;
  line-height:1.5;
}
.log-flow-prompt-actions,
.log-flow-done-actions{
  width:100%;
  display:flex;
  flex-direction:column;
  gap:10px;
}
.log-flow-prompt-actions button,
.log-flow-done-actions .log-flow-cta{
  margin:0;
  opacity:1;
  pointer-events:all;
}
.log-flow-skip-link{
  background:none;
  border:none;
  color:var(--muted);
  font-family:'Space Grotesk',sans-serif;
  font-size:14px;
  font-weight:600;
  padding:12px;
  cursor:pointer;
  -webkit-tap-highlight-color:transparent;
}
.log-flow-done-reflection{
  width:100%;
  margin-top:20px;
  text-align:left;
}

/* Terrain picker on wizard screens */
#log-terrain-group .log-terrain-picker{display:flex;flex-direction:column;gap:8px;}
#log-terrain-group .setting-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
#log-terrain-group .terrain-chips{display:grid;grid-template-columns:1fr 1fr;gap:8px;width:100%;flex-wrap:unset;overflow:visible;}
#log-terrain-group .setting-row .chip,
#log-terrain-group .terrain-chips .chip{
  width:100%;text-align:center;padding:12px 8px;font-size:14px;
}

/* Premium activation dial polish */
.gauge-sweet-glow path[stroke="rgba(255,255,255,.55)"]{
  stroke:rgba(255,255,255,.75);
  filter:drop-shadow(0 0 6px rgba(245,166,35,.45));
}
.gauge-idle-pulse .gauge-drag-handle{
  animation:gaugeIdlePulse 2.4s ease-in-out infinite;
}
.gauge-hub-pulse .gauge-needle-hub{
  animation:gaugeHubPulse 2s ease-in-out infinite;
}
@keyframes gaugeIdlePulse{
  0%,100%{box-shadow:0 2px 6px rgba(0,0,0,.3), 0 0 0 0 rgba(232,118,58,.35);}
  50%{box-shadow:0 2px 8px rgba(0,0,0,.35), 0 0 0 8px rgba(232,118,58,0);}
}
@keyframes gaugeHubPulse{
  0%,100%{opacity:1;}
  50%{opacity:.65;}
}
