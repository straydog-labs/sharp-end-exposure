<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#2a2420;--surface:#3a3228;--surface2:#463e34;--border:#5a5248;
  --text:#ffffff;--muted:#e8ddd4;--muted2:#c0b8ae;
  --accent:#e8763a;--r-lg:14px;--r-md:10px;
