body{background:var(--bg);color:var(--text);font-family:'Space Grotesk',sans-serif;line-height:1.6;font-weight:500;-webkit-font-smoothing:antialiased;}
.wrap{max-width:680px;margin:0 auto;padding:32px 20px 80px;}
.back-link{display:inline-flex;align-items:center;gap:6px;color:var(--muted);text-decoration:none;font-size:14px;font-weight:600;margin-bottom:28px;}
.back-link:hover{color:var(--accent);}
.wordmark{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:6px;}
.wordmark span{color:var(--accent);}
h1{font-size:26px;font-weight:700;letter-spacing:-.02em;margin-bottom:8px;}
.updated{font-size:13px;color:var(--muted2);margin-bottom:28px;}
.notice{background:var(--surface);border:1px solid rgba(232,118,58,.35);border-radius:var(--r-lg);padding:16px 18px;margin-bottom:32px;font-size:14px;color:var(--muted);line-height:1.6;}
.notice strong{color:var(--accent);}
h2{font-size:18px;font-weight:700;color:var(--text);margin:32px 0 12px;letter-spacing:-.01em;}
p{font-size:15px;color:var(--muted);margin-bottom:14px;}
ul{margin:0 0 14px 20px;}
li{font-size:15px;color:var(--muted);margin-bottom:8px;}
strong{color:var(--text);}
a{color:var(--accent);}
table{width:100%;border-collapse:collapse;margin-bottom:18px;}
th,td{text-align:left;font-size:14px;color:var(--muted);padding:8px 10px;border-bottom:1px solid var(--border);}
th{color:var(--text);font-size:12px;text-transform:uppercase;letter-spacing:.06em;}
.contact{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:18px;margin-top:32px;font-size:14px;color:var(--muted);}
