// ═══════════════════════════════════════════════════════
// LOG FLOW — activation-first wizard (build 186+)
// Insert BEFORE async function logClimb()
// ═══════════════════════════════════════════════════════

var logFlowState = { step: 1, activationTouched: false, activationScore: 6, modelZone: null, modelScore: null, adjustScore: null };

function scoreToZone(score){
  return score <= 4 ? 'comfort' : score <= 9 ? 'learning' : 'panic';
}

function startLogFlow(){
  resetLogScreen();
  logFlowState = { step: 1, activationTouched: false, activationScore: 6, modelZone: null, modelScore: null, adjustScore: null };
  logState.userActivationEstimate = null;
  window._sessionStartTime = Date.now();
  _resetLogFlowContinueButtons();
  showScreen('screen-log-act');
  updateLogFlowProgress(1);
  setTimeout(initLogActivationGauge, 50);
}

function _resetLogFlowContinueButtons(){
  ['log-act-continue','log-result-continue','log-terrain-continue','log-grade-continue'].forEach(function(id){
    var btn = document.getElementById(id);
    if(btn) btn.classList.remove('ready');
  });
}

function updateLogFlowProgress(step){
  logFlowState.step = step;
  var pctMap = { 1: 20, 2: 40, 3: 60, 4: 80, 5: 100 };
  var pct = pctMap[step] || 20;
  document.querySelectorAll('.log-flow-progress').forEach(function(el){
    if(parseInt(el.getAttribute('data-step'), 10) === step){
      var fill = el.querySelector('.log-flow-progress-fill');
      if(fill) fill.style.width = pct + '%';
    }
  });
}

function _applyPremiumGaugeClasses(containerId){
  var container = document.getElementById(containerId);
  if(!container) return;
  container.classList.add('gauge-sweet-glow');
  var wrap = container.querySelector('div[style*="position:relative"]');
  if(wrap){
    wrap.classList.add('gauge-idle-pulse', 'gauge-hub-pulse');
  }
}

function _hookLogFlowGaugeTouch(containerId, onRelease, onChange, snapHalf){
  var container = document.getElementById(containerId);
  if(!container) return;
  var dialTarget = container.querySelector('.gauge-dial-target');
  if(!dialTarget) return;
  var touched = false;
  function emitChange(rawScore){
    var score = snapHalf ? Math.round(rawScore * 2) / 2 : rawScore;
    if(onChange) onChange(score);
    return score;
  }
  dialTarget.addEventListener('pointerdown', function(){
    if(!touched){
      touched = true;
      if(onRelease) onRelease();
    }
  });
  dialTarget.addEventListener('pointermove', function(e){
    if(e.buttons === 0 && e.pressure === 0) return;
    var rect = container.querySelector('div[style*="position:relative"]').getBoundingClientRect();
    var pivotX = rect.width / 2;
    var pivotBottomOffset = rect.height;
    var dx = e.clientX - rect.left - pivotX;
    var dyp = pivotBottomOffset - (e.clientY - rect.top);
    var ang = Math.atan2(dyp, dx) * 180 / Math.PI;
    ang = Math.max(0, Math.min(180, ang));
    emitChange(12 * (1 - ang / 180));
  });
  dialTarget.addEventListener('pointerup', function(){
    var readout = container.querySelector('div[style*="text-align:center"]');
    if(readout && readout.children[0]){
      var txt = readout.children[0].textContent;
      var score = parseFloat(txt);
      if(!isNaN(score)) emitChange(score);
    }
  });
}

function initLogActivationGauge(){
  var actScreen = document.getElementById('screen-log-act');
  if(actScreen && !actScreen.classList.contains('active')){
    showScreen('screen-log-act');
  }
  buildActivationGauge('log-act-gauge', logFlowState.activationScore, 'estimated', true, onLogActivationChange, null);
  _applyPremiumGaugeClasses('log-act-gauge');
  _hookLogFlowGaugeTouch('log-act-gauge', onLogActivationRelease, onLogActivationChange, true);
}

function onLogActivationChange(score){
  logFlowState.activationScore = score;
  logState.userActivationEstimate = Math.round(score * 2) / 2;
}

function onLogActivationRelease(){
  logFlowState.activationTouched = true;
  var btn = document.getElementById('log-act-continue');
  if(btn) btn.classList.add('ready');
}

function logFlowContinueFromActivation(){
  if(logState.userActivationEstimate === null && logState.userActivationEstimate !== 0){
    logState.userActivationEstimate = logFlowState.activationScore;
  }
  showScreen('screen-log-result');
  updateLogFlowProgress(2);
}

function selectLogResult(r){
  selectResult(r);
  var btn = document.getElementById('log-result-continue');
  if(btn) btn.classList.add('ready');
}

function logFlowContinueFromResult(){
  if(!logState.result){ showToast('Pick a result first'); return; }
  showScreen('screen-log-terrain');
  updateLogFlowProgress(3);
}

function logFlowContinueFromTerrain(){
  if(!logState.terrain){ showToast('Pick a terrain type'); return; }
  showScreen('screen-log-grade');
  updateLogFlowProgress(4);
  buildGradeGrid(logState.gradeSys || 'YDS');
}

function logFlowContinueFromGrade(){
  if(!logState.grade){ showToast('Pick a grade'); return; }
  showScreen('screen-log-name');
  updateLogFlowProgress(5);
  var inp = document.getElementById('log-rname-input');
  if(inp) setTimeout(function(){ inp.focus(); }, 100);
}

function _logFlowReflectionFields(){
  return {
    went_well:(function(){var t=document.getElementById('went-well-text');var chips=Array.from(document.querySelectorAll('#log-reflection-group .refl-chip.selected[onclick*="went-well"]')).map(function(b){return b.textContent.trim();}).join(',');return(t&&t.value.trim())?t.value.trim():(chips||null);})(),
    still_learning:(function(){var t=document.getElementById('still-learning-text');var chips=Array.from(document.querySelectorAll('#log-reflection-group .refl-chip.selected[onclick*="still-learning"]')).map(function(b){return b.textContent.trim();}).join(',');return(t&&t.value.trim())?t.value.trim():(chips||null);})(),
    surprised_by:(function(){var t=document.getElementById('surprised-text');var chips=Array.from(document.querySelectorAll('#log-reflection-group .refl-chip.selected[onclick*="surprised"]')).map(function(b){return b.textContent.trim();}).join(',');return(t&&t.value.trim())?t.value.trim():(chips||null);})(),
    went_well_chips:(function(){return Array.from(document.querySelectorAll('#log-reflection-group .refl-chip.selected[onclick*="went-well"]')).map(function(b){return b.textContent.trim();}).join(',')||null;})(),
    still_learning_chips:(function(){return Array.from(document.querySelectorAll('#log-reflection-group .refl-chip.selected[onclick*="still-learning"]')).map(function(b){return b.textContent.trim();}).join(',')||null;})(),
    surprised_chips:(function(){return Array.from(document.querySelectorAll('#log-reflection-group .refl-chip.selected[onclick*="surprised"]')).map(function(b){return b.textContent.trim();}).join(',')||null;})()
  };
}

async function logFlowSaveReflectionIfFilled(){
  if(!logState.sessId) return;
  var refl = _logFlowReflectionFields();
  var hasAny = refl.went_well || refl.still_learning || refl.surprised_by;
  if(!hasAny) return;
  await sbU('sessions', 'id=eq.' + logState.sessId, refl);
}

async function logFlowSaveSession(){
  deepAnswers = { q1: null, q2: null, q3: null, q4: null, q5: null, q6: null, q7: null };
  deepScores = { breath: null, gut: null, crux: null, body: null };

  var nameInp = document.getElementById('log-rname-input');
  if(nameInp) logState.routeName = nameInp.value.trim() || null;

  if(!logState.result || !logState.grade || !logState.terrain){
    showToast('Complete result, grade, and terrain first');
    return;
  }

  var saveBtn = document.getElementById('log-name-save');
  if(saveBtn){ saveBtn.textContent = 'Saving...'; saveBtn.classList.remove('ready'); }

  var zr = resolveZone({ result: logState.result });
  logState.zone = zr.zone;
  logState.zoneConf = zr.confidence;

  if(logState.userActivationEstimate === null && logState.userActivationEstimate !== 0){
    logState.userActivationEstimate = logFlowState.activationScore;
  }

  var climbId = _selectedClimbId || null;
  if(!logState.routeName && drillState && drillState.routeName){
    logState.routeName = drillState.routeName;
  }
  if(!logState.routeName && !climbId){
    var n = (window._userClimbCount || 0) + 1;
    logState.routeName = 'Climb ' + n;
  }

  if(!climbId && logState.routeName){
    var climbs = await loadClimbCache();
    var q = normalizeClimbName(logState.routeName);
    var match = climbs.find(function(c){ return normalizeClimbName(c.name) === q; });
    if(match){
      climbId = match.id;
    } else {
      var newClimb = await sbI('climbs', {
        device_id: getDeviceId(),
        user_id: window._authUser ? window._authUser.id : null,
        name: logState.routeName.trim(),
        grade_value: logState.grade || null,
        climbing_type: logState.terrain || null
      });
      if(newClimb && newClimb.id){
        climbId = newClimb.id;
        _climbCache = null;
      }
    }
  }

  var payload = {
    baseline_zone: logState.result,
    grade_value: logState.grade,
    setting: logState.setting || null,
    grade_system: logState.gradeSys,
    climbing_type: logState.terrain,
    route_name: logState.routeName || null,
    climb_id: climbId || null,
    zone: logState.zone,
    zone_confidence: logState.zoneConf,
    user_activation_estimate: Math.round(logState.userActivationEstimate),
    user_id: window._authUser ? window._authUser.id : null,
    app_version: app_version,
    device_id: getDeviceId(),
    drill_prediction_zone: (drillState && drillState.prediction) ? drillState.prediction.zone : null,
    drill_prediction_value: (drillState && drillState.prediction) ? drillState.prediction.value : null,
    drill_prediction_label: (drillState && drillState.prediction) ? drillState.prediction.label : null,
    prepare_session_id: window._prepareSessionId || null,
    session_duration_seconds: window._sessionStartTime ? Math.round((Date.now() - window._sessionStartTime) / 1000) : null,
    session_focus: 'unset'
  };

  try{
    var baselineRange = localStorage.getItem('see_baseline_grade_range');
    if(baselineRange && logState.grade && window.GRADE_ORDER){
      var gradeIdx = window.GRADE_ORDER.indexOf(logState.grade);
      var rangeMap = {
        '5.8 and below': [0, 4], '5.9–5.10a': [5, 6], '5.10b–5.10d': [7, 9],
        '5.11a–5.11c': [10, 12], '5.11d–5.12b': [13, 15], '5.12c+': [16, 99],
        'VB–V2': [0, 2], 'V3–V4': [3, 4], 'V5–V6': [5, 6], 'V7–V8': [7, 8], 'V9+': [9, 99]
      };
      var range = rangeMap[baselineRange];
      if(range && gradeIdx > -1){
        payload.grade_vs_baseline = gradeIdx < range[0] ? 'below' : gradeIdx > range[1] ? 'above' : 'within';
      }
    }
  } catch(e){}

  var raw = await sbI('sessions', payload);
  if(raw === null){
    offlineQueueAdd(payload, logState.routeName, climbId);
    showToast('Saved offline');
    showScreen('screen-log-prompt');
    if(saveBtn){ saveBtn.textContent = 'Save climb'; saveBtn.classList.add('ready'); }
    return;
  }

  var saved = Array.isArray(raw) ? raw[0] : raw;
  if(saved && saved.id){
    logState.sessId = saved.id;
    showToast('Logged ✓');
    window._prepareSessionId = null;

    if(logState.result === 'fell' && window._authUser){
      var fallNotesEl = document.getElementById('fall-notes-text');
      var fallNotes = fallNotesEl ? fallNotesEl.value.trim() : '';
      var hasFallData = fallState.got_back_on || fallState.vs_expect || fallState.fall_description || fallState.catch_quality || fallState.fall_consequence || fallNotes;
      if(hasFallData){
        sbI('falls', {
          session_id: saved.id,
          user_id: window._authUser.id,
          device_id: getDeviceId(),
          got_back_on: fallState.got_back_on,
          vs_expect: fallState.vs_expect,
          fall_description: fallState.fall_description,
          catch_quality: fallState.catch_quality,
          fall_consequence: fallState.fall_consequence,
          learning_reflection: fallNotes || null
        });
      }
    }
    if(logState.result === 'dna' && window._authUser){
      var backoffNotesEl = document.getElementById('backoff-notes-text');
      var backoffNotes = backoffNotesEl ? backoffNotesEl.value.trim() : '';
      var hasBackoffData = backoffState.reason || backoffState.vs_expect || backoffState.call_feeling || backoffNotes;
      if(hasBackoffData){
        sbI('backoffs', {
          session_id: saved.id,
          user_id: window._authUser.id,
          device_id: getDeviceId(),
          reason: backoffState.reason,
          vs_expect: backoffState.vs_expect,
          call_feeling: backoffState.call_feeling,
          notes: backoffNotes || null
        });
      }
    }
    if(logState.result === 'sent' && window._authUser){
      var sendNotesEl = document.getElementById('send-notes-text');
      var sendNotes = sendNotesEl ? sendNotesEl.value.trim() : '';
      var hasSendData = sendState.standout || sendState.moment_feeling || sendState.reflection_feeling || sendNotes;
      if(hasSendData){
        sbI('sends', {
          session_id: saved.id,
          user_id: window._authUser.id,
          device_id: getDeviceId(),
          standout: sendState.standout,
          moment_feeling: sendState.moment_feeling,
          reflection_feeling: sendState.reflection_feeling,
          notes: sendNotes || null
        });
      }
    }

    var doneSub = document.getElementById('log-done-subtitle');
    if(doneSub){
      var lbl = { sent: 'Sent', fell: 'Fell', dna: 'Backed off' };
      doneSub.textContent = (logState.grade || '') + (logState.terrain ? ' · ' + logState.terrain : '') + (logState.result ? ' · ' + (lbl[logState.result] || logState.result) : '');
    }

    if(_drillPostActive){
      _drillPostActive = false;
      startPostClimbCheckin();
    } else {
      showScreen('screen-log-prompt');
    }

    loadHomeInsight();
    (window._authUser && window._authUser.id
      ? sbS('sessions', 'select=*&user_id=eq.' + window._authUser.id + '&deleted_at=is.null&order=created_at.desc&limit=100')
      : sbS('sessions', 'select=*&device_id=eq.' + getDeviceId() + '&deleted_at=is.null&order=created_at.desc&limit=100')
    ).then(function(s){
      window._cachedSessions = Array.isArray(s) ? s.filter(function(x){ return !x.is_checkin; }) : [];
    });
  } else {
    showToast('Could not save — try again', true);
  }

  if(saveBtn){ saveBtn.textContent = 'Save climb'; saveBtn.classList.add('ready'); }
}

function logFlowSkipDeeper(){
  showScreen('screen-log-done');
}

function logFlowStartDeeper(){
  startDeeper();
  var backBtn = document.querySelector('#screen-deeper .back-btn');
  if(backBtn){
    backBtn.setAttribute('onclick', '');
    backBtn.onclick = function(){ showScreen('screen-log-prompt'); };
  }
}

function showLogReveal(){
  logFlowState.modelZone = logState.zone;
  logFlowState.modelScore = window._zcScore;
  var userScore = logState.userActivationEstimate;
  if(userScore === null || userScore === undefined) userScore = logFlowState.activationScore;
  var modelScore = window._zcScore !== undefined ? window._zcScore : 6.5;
  var intro = document.getElementById('log-reveal-intro');
  if(intro){
    intro.textContent = 'You read ' + userScore.toFixed(1) + ' (' + zoneName(scoreToZone(userScore)) + '). Your body data suggests ' + modelScore.toFixed(1) + ' (' + zoneName(logFlowState.modelZone || scoreToZone(modelScore)) + ').';
  }
  var dialWrap = document.getElementById('log-reveal-dial-wrap');
  if(dialWrap) dialWrap.style.display = 'none';
  showScreen('screen-log-reveal');
  setTimeout(function(){
    buildActivationGauge('log-reveal-gauge', modelScore, 'confirmed', false, null, userScore);
  }, 50);
}

function logRevealConfirmOwn(){
  var score = logState.userActivationEstimate;
  if(score === null || score === undefined) score = logFlowState.activationScore;
  manualOverrideZone(score);
  showScreen('screen-log-done');
}

function logRevealAcceptModel(){
  acceptCalculatedZone();
  showScreen('screen-log-done');
}

function logRevealAdjustDial(){
  var wrap = document.getElementById('log-reveal-dial-wrap');
  if(wrap) wrap.style.display = 'block';
  var startScore = logFlowState.modelScore !== null ? logFlowState.modelScore : (window._zcScore !== undefined ? window._zcScore : 6);
  setTimeout(function(){
    buildActivationGauge('log-reveal-adjust-gauge', startScore, 'manual', true, function(score){
      logFlowState.adjustScore = score;
    });
  }, 50);
}

function logRevealSaveAdjust(){
  var score = logFlowState.adjustScore !== null && logFlowState.adjustScore !== undefined
    ? logFlowState.adjustScore
    : (window._zcScore !== undefined ? window._zcScore : 6);
  manualOverrideZone(score);
  showScreen('screen-log-done');
}

async function logFlowLogAnother(){
  await logFlowSaveReflectionIfFilled();
  startLogFlow();
}

async function logFlowDoneHome(){
  await logFlowSaveReflectionIfFilled();
  celebrateHomeLink();
}

// Enable terrain / grade continue buttons when selections are made on wizard screens
(function(){
  var _selectTerrainOrig = selectTerrain;
  selectTerrain = function(btn, terrain){
    _selectTerrainOrig(btn, terrain);
    var terrainScreen = document.getElementById('screen-log-terrain');
    if(terrainScreen && terrainScreen.classList.contains('active')){
      var cont = document.getElementById('log-terrain-continue');
      if(cont) cont.classList.add('ready');
    }
  };
  var _selectGradeOrig = selectGrade;
  selectGrade = function(btn, sys){
    _selectGradeOrig(btn, sys);
    var gradeScreen = document.getElementById('screen-log-grade');
    if(gradeScreen && gradeScreen.classList.contains('active')){
      var cont = document.getElementById('log-grade-continue');
      if(cont) cont.classList.add('ready');
    }
  };
})();

// ── REPLACEMENT for afterQ4() — route to reveal instead of zone confirmed ──
async function afterQ4(){
  var anyAnswered = deepAnswers.q1 || deepAnswers.q2 || deepAnswers.q3 || deepAnswers.q4;
  if(!anyAnswered){
    showToast('No changes — zone stays as estimated');
    showScreen('screen-log-done');
    return;
  }
  var zr = resolveZone({
    breathScore: deepScores.breath !== null ? deepScores.breath : 1,
    gutScore: deepScores.gut !== null ? deepScores.gut : 1,
    cruxScore: deepScores.crux !== null ? deepScores.crux : 0,
    bodyScore: deepScores.body !== null ? deepScores.body : 1
  });
  var prevZone = logState.zone;
  logState.zone = zr.zone;
  logState.zoneConf = 'confirmed';
  window._zcScore = zr.score;
  logFlowState.modelZone = zr.zone;
  logFlowState.modelScore = zr.score;

  if(logState.sessId){
    await sbU('sessions', 'id=eq.' + logState.sessId, {
      breathing_post: deepAnswers.q1,
      gut_post: deepAnswers.q2,
      crux_response: deepAnswers.q3,
      body_state: deepAnswers.q4,
      zone: logState.zone,
      zone_confidence: 'confirmed'
    });
  }

  window._prevZoneForConfirm = prevZone;
  showLogReveal();
  window._prevZoneForConfirm = null;
}
